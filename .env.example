# VisoMaster — Environment Configuration Template
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# ── Tailscale VPN (optional) ──────────────────────────────────────────────────
# Provides a private network tunnel for WebRTC on cloud/RunPod environments
# where direct UDP access is blocked by a proxy.
# Generate a reusable auth key at: https://login.tailscale.com/admin/settings/keys
#
TAILSCALE_AUTHKEY=

# ── API Server ────────────────────────────────────────────────────────────────
# Port for the FastAPI backend (default: 8000)
# API_PORT=8000

# ── Vite Dev Server ───────────────────────────────────────────────────────────
# Port the Vite dev server listens on (default: 5173)
# VITE_PORT=5173
